{
  "_readme": "ロボカップジュニアのニュース／ルール情報の収集元設定。URL が変わったらこのファイルだけを直せば直ります。urls は候補リストで、上から順に試して最初に成功したものを使います。",

  "timezone": "Asia/Tokyo",

  "options": {
    "max_age_days": 210,
    "max_items_per_source": 8,
    "max_items_total": 40,
    "first_run_items_per_source": 3,
    "post_when_empty": true,
    "include_general": true,
    "http_timeout": 20,
    "http_retries": 2,
    "total_time_budget": 600
  },

  "leagues": {
    "soccer": {
      "label": "サッカー",
      "emoji": "⚽",
      "keywords": [
        "サッカー", "ｻｯｶｰ", "soccer", "lightweight", "ライトウェイト",
        "オープン", "open league", "ドリブラー", "dribbler",
        "日本リーグ", "ワールドリーグ", "world league"
      ]
    },
    "onstage": {
      "label": "オンステージ",
      "emoji": "🎭",
      "keywords": [
        "オンステージ", "ｵﾝｽﾃｰｼﾞ", "onstage", "on stage", "on-stage",
        "ステージ", "ダンス", "dance", "パフォーマンス", "performance"
      ]
    }
  },

  "general": {
    "label": "全般",
    "emoji": "📢"
  },

  "exclude_keywords": [
    "レスキュー", "ﾚｽｷｭｰ", "rescue", "rescue line", "rescue maze",
    "ライントレース", "シミュレーション", "simulation", "sim demo",
    "@home", "industrial", "ロボカップアジアパシフィック レスキュー"
  ],

  "regions": [
    { "id": "chiba", "label": "千葉", "emoji": "🏫", "color": 3066993, "order": 1 },
    { "id": "kanto", "label": "関東", "emoji": "🗼", "color": 3447003, "order": 2 },
    { "id": "japan", "label": "日本", "emoji": "🇯🇵", "color": 15158332, "order": 3 },
    { "id": "world", "label": "世界", "emoji": "🌏", "color": 10181046, "order": 4 }
  ],

